# Public OAuth client configuration used by the native Google sign-in flow.
# This is a client ID, not an OAuth client secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=0
# Public HTTPS /chat endpoint, NOT an API key. Leave blank until the authenticated
# Cloudflare Worker passes a real Qwen inference smoke test and privacy review.
EXPO_PUBLIC_MYELIN_CHAT_ENDPOINT=
