{
  "expo": {
    "name": "MYELIN",
    "slug": "myelin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "myelin",
    "android": {
      "package": "com.djgaming1t.myelin",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.djgaming1t.myelin"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
