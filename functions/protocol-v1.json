                        },
                        "subject": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "status": {
                          "enum": [
                            "new",
                            "learning",
                            "review"
                          ]
                        },
                        "priority": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3
                        },
                        "estimatedMinutes": {
                          "type": "integer",
                          "minimum": 5,
                          "maximum": 240
                        },
                        "notes": {
                          "type": "string",
                          "maxLength": 20000
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
