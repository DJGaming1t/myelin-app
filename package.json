{
  "name": "myelin-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "verify:data": "tsx scripts/verify-data.ts",
    "verify:topics": "tsx scripts/verify-topics.ts",
    "verify:today": "tsx scripts/verify-today.ts",
    "verify:focus": "tsx scripts/verify-focus.ts",
    "verify:review": "tsx scripts/verify-review.ts",
    "verify:mistakes": "tsx scripts/verify-mistakes.ts",
    "verify:exams": "tsx scripts/verify-exams.ts",
    "verify:progress": "tsx scripts/verify-progress.ts",
    "verify:settings": "tsx scripts/verify-settings.ts",
    "verify:transfer": "tsx scripts/verify-transfer.ts",
    "verify:cloud": "tsx scripts/verify-cloud.ts",
    "verify:cloud-conversation": "tsx scripts/verify-cloud-conversation.ts",
    "test:firestore-rules": "tsx scripts/test-firestore-rules.ts",
    "verify:firestore-rules": "firebase emulators:exec --project demo-myelin-sync --only firestore \"npm run test:firestore-rules\"",
    "verify:notifications": "tsx scripts/verify-notifications.ts",
    "verify:onboarding": "tsx scripts/verify-onboarding.ts",
    "verify:guides": "tsx scripts/verify-guides.ts",
    "verify:help": "tsx scripts/verify-help.ts",
    "verify:polish": "tsx scripts/verify-polish.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "eas:development": "npx eas-cli@latest build --platform android --profile development",
    "eas:preview": "npx eas-cli@latest build --platform android --profile preview",
    "eas:production": "npx eas-cli@latest build --platform android --profile production",
    "eas:update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "eas:update:production": "npx eas-cli@latest update --channel production --environment production",
    "verify:planning": "tsx scripts/verify-planning.ts",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "verify:visual": "tsx scripts/verify-visual-overhaul.ts",
    "verify:exam-plan": "tsx scripts/verify-exam-plan.ts",
    "verify:feasibility": "tsx scripts/verify-feasibility.ts",
    "verify:assistant-actions": "tsx scripts/verify-assistant-actions.ts",
    "verify:local-ai": "tsx scripts/verify-local-ai.ts",
    "verify:syllabus-intake": "tsx scripts/verify-syllabus-intake.ts",
    "verify:myelin-mini": "tsx scripts/verify-myelin-mini.ts && tsx scripts/verify-myelin-mini-fast-router.ts && tsx scripts/generate-myelin-mini-failure-data.ts && tsx scripts/build-myelin-mini-dataset.ts --check",
    "build:myelin-mini-dataset": "tsx scripts/generate-myelin-mini-failure-data.ts && tsx scripts/build-myelin-mini-dataset.ts",
    "benchmark:myelin-mini": "tsx scripts/benchmark-myelin-mini.ts",
    "generate:myelin-mini-failure-data": "tsx scripts/generate-myelin-mini-failure-data.ts",
    "export:myelin-mini-eval-prompts": "tsx scripts/export-myelin-mini-eval-prompts.ts",
    "evaluate:myelin-mini-predictions": "tsx scripts/evaluate-myelin-mini-predictions.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.10",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.23",
    "firebase": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-litert-lm": "0.7.0",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.32.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
